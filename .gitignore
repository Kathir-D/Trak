# Rust
/target/
# Spike crates are throwaway; their build output never belongs in the repo
/spikes/*/target/
/spikes/*/Cargo.lock
# Release artifacts (rebuilt by scripts/package-release.sh)
/dist/
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Logs
*.log
# Env / secrets — never commit API keys, tokens, certs
.env
*.p12
# Local agent settings
.claude/settings.local.json

# Python bytecode from the scripts/
__pycache__/
*.pyc

#!/usr/bin/env python3
"""A fake `osascript` for Trak, so a demo or a measurement is repeatable.

Answers like Spotify does, in the times `docs/APPLESCRIPT.md` §4 records (431 ms
for the batched read, ~120 ms for a write, ~140 ms for a single property), and
logs every call with a timestamp. `TRAK_OSASCRIPT=$PWD/scripts/fake-spotify trak`
runs against it.

It plays a two-song queue, and the writes trak sends (play/pause, next/previous,
shuffle, repeat, volume, seek) really change what the next read returns, so a
demo can skip tracks and see the cover and the accent change. The track ids and
artwork URLs are the real ones: the cover is fetched from Spotify's CDN and the
accent is taken from it, so they have to be right. Check one with
`curl "https://open.spotify.com/oembed?url=https://open.spotify.com/track/<id>"`.

Every call is a separate process, so the state lives in a JSON file
(`STUB_STATE_FILE`); delete it to start over. Set `STUB_PAUSED=1` to start
paused, and `STUB_LOG=/dev/null` to stop the call log. `STUB_READ` /
`STUB_WRITE` / `STUB_VOL_READ` are the delays in seconds. `STUB_STATE` replaces
the whole read with a fixed string.
"""
import json
import os
import sys
import time

READ_S = float(os.environ.get("STUB_READ", "0.43"))
WRITE_S = float(os.environ.get("STUB_WRITE", "0.12"))
LOG = os.environ.get("STUB_LOG", "/tmp/trak-stub.log")
STATE = os.environ.get("STUB_STATE", "")
STATE_FILE = os.environ.get("STUB_STATE_FILE", "/tmp/trak-fake-spotify.json")

# (name, artist, album, duration ms, track number, track id, artwork id, start s).
# `start` is where the song is when it comes on, so the lyrics are mid-verse.
TRACKS = [
    ("Dancing with your eyes closed", "Jane Remover", "Dancing with your eyes closed",
     231000, 1, "1XD4K4CGAKTIBmFpvuaFru", "ab67616d0000b273ab0d83b752dcf9f2a7ddd51b", 34.0),
    ("Beauty Sleep", "Jane Remover", "Beauty Sleep",
     222000, 1, "1RrEB90qVYRsVE1DQsqwuJ", "ab67616d0000b27325920ac69f3ad8a4b6065167", 33.0),
]

script = sys.stdin.read()
now = time.time()
with open(LOG, "a") as fh:
    tag = ("VOL_WRITE" if "sound volume to" in script
           else "VOL_READ" if ("sound volume" in script and "player state" not in script)
           else "STATE_READ" if "current track" in script
           else "OTHER")
    fh.write(f"{now:.4f} {tag}\n")

try:
    with open(STATE_FILE) as fh:
        st = json.load(fh)
except (OSError, ValueError):
    st = {"track": 0, "playing": not os.environ.get("STUB_PAUSED"), "volume": 40,
          "shuffle": False, "repeat": False, "pos": TRACKS[0][7], "at": now}


def position():
    """Where the song is now: it only moves while it plays."""
    p = st["pos"] + (now - st["at"] if st["playing"] else 0.0)
    return min(p, TRACKS[st["track"]][3] / 1000)


def seek(p):
    st["pos"], st["at"] = p, now


def save():
    with open(STATE_FILE, "w") as fh:
        json.dump(st, fh)


if "tell application" not in script:
    # `is_running()`: just the check.
    print("true")
    sys.exit(0)

if "current track" not in script and "sound volume" in script and "sound volume to" not in script:
    # One property, one Apple Event: ~140 ms, not the 430 ms of the full read.
    time.sleep(float(os.environ.get("STUB_VOL_READ", "0.14")))
    print(st["volume"])
    sys.exit(0)

if "current track" not in script:
    # A one-line write. Order matters: "playpause" contains "pause" and "play".
    line = script.split("tell application \"Spotify\"", 1)[-1]
    if "playpause" in line:
        seek(position())
        st["playing"] = not st["playing"]
    elif "next track" in line or "previous track" in line:
        step = 1 if "next track" in line else -1
        st["track"] = (st["track"] + step) % len(TRACKS)
        st["playing"] = True
        seek(TRACKS[st["track"]][7])
    elif "set sound volume to" in line:
        try:
            st["volume"] = max(0, min(100, int(line.split("sound volume to")[1].split()[0])))
        except (IndexError, ValueError):
            pass
    elif "set shuffling to" in line:
        st["shuffle"] = "to true" in line
    elif "set repeating to" in line:
        st["repeat"] = "to true" in line
    elif "set player position to" in line:
        try:
            seek(float(line.split("position to")[1].split()[0]))
        except (IndexError, ValueError):
            pass
    elif "pause" in line:
        seek(position())
        st["playing"] = False
    elif "play" in line:
        seek(position())
        st["playing"] = True
    save()
    time.sleep(WRITE_S)
    print("ok")
    sys.exit(0)

save()
time.sleep(READ_S)
if STATE:
    print(STATE)
    sys.exit(0)
name, artist, album, dur, num, tid, art, _ = TRACKS[st["track"]]
fields = ["playing" if st["playing"] else "paused", f"{position():.6f}", str(st["volume"]),
          str(st["shuffle"]).lower(), str(st["repeat"]).lower(), name, artist, album, artist,
          str(dur), "1", str(num), "48", "0", f"https://i.scdn.co/image/{art}",
          f"https://open.spotify.com/track/{tid}", f"spotify:track:{tid}"]
print("\x1f".join(fields))
